#!/bin/bash
#
# git-snapc-smrt-interdiff - AI-powered multi-commit snapshot creation using interdiff
# 
# This implementation uses interdiff for cleaner patch management instead of
# the reverse patch approach in git-smrtsnap-auto

set -euo pipefail

# Colors for output
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Configuration
MAX_CLAUDE_RETRIES=3
CLAUDE_RETRY_DELAY=2

echo -e "${CYAN}🤖 git-snapc-smrt-interdiff - Using interdiff for patch management${NC}"

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository${NC}"
    exit 1
fi

# Create temporary directory for patch management
TEMP_DIR=$(mktemp -d)
trap "rm -rf $TEMP_DIR" EXIT

# Categorize files by status
declare -A file_status
declare -a untracked_files modified_files deleted_files added_files

while IFS= read -r line; do
    status="${line:0:2}"
    file="${line:3}"
    
    case "$status" in
        "??") untracked_files+=("$file"); file_status["$file"]="untracked" ;;
        " M"|"M "|"MM") modified_files+=("$file"); file_status["$file"]="modified" ;;
        " D"|"D ") deleted_files+=("$file"); file_status["$file"]="deleted" ;;
        "A "|" A") added_files+=("$file"); file_status["$file"]="added" ;;
    esac
done < <(git status --porcelain)

# Check if there are any changes
if [[ ${#untracked_files[@]} -eq 0 && ${#modified_files[@]} -eq 0 && 
      ${#deleted_files[@]} -eq 0 && ${#added_files[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No changes to commit${NC}"
    exit 0
fi

echo -e "${CYAN}📊 Found changes:${NC}"
[[ ${#modified_files[@]} -gt 0 ]] && echo "  - ${#modified_files[@]} modified files"
[[ ${#untracked_files[@]} -gt 0 ]] && echo "  - ${#untracked_files[@]} untracked files"
[[ ${#deleted_files[@]} -gt 0 ]] && echo "  - ${#deleted_files[@]} deleted files"
[[ ${#added_files[@]} -gt 0 ]] && echo "  - ${#added_files[@]} added files"

# Create the full diff including untracked files
create_full_diff() {
    local output_file="$1"
    
    # Get diff for tracked changes
    git diff HEAD > "$TEMP_DIR/tracked.diff"
    
    # Create diffs for untracked files
    > "$TEMP_DIR/untracked.diff"
    for file in "${untracked_files[@]}"; do
        echo "diff --git a/$file b/$file" >> "$TEMP_DIR/untracked.diff"
        echo "new file mode 100644" >> "$TEMP_DIR/untracked.diff"
        echo "index 0000000..0000000" >> "$TEMP_DIR/untracked.diff"
        echo "--- /dev/null" >> "$TEMP_DIR/untracked.diff"
        echo "+++ b/$file" >> "$TEMP_DIR/untracked.diff"
        awk '{print "+" $0}' "$file" >> "$TEMP_DIR/untracked.diff"
    done
    
    # Combine all diffs
    cat "$TEMP_DIR/tracked.diff" "$TEMP_DIR/untracked.diff" > "$output_file"
}

# Function to call Claude with retries
call_claude() {
    local prompt="$1"
    local attempt=0
    local response
    
    while [[ $attempt -lt $MAX_CLAUDE_RETRIES ]]; do
        echo -e "${CYAN}🤖 Calling Claude (attempt $((attempt + 1))/$MAX_CLAUDE_RETRIES)...${NC}"
        
        # Use claude -p for non-interactive execution with JSON output
        response=$(claude -p "$prompt" --output-format json --max-turns 5 2>&1) || true
        
        if [[ -n "$response" ]] && echo "$response" | jq -e '.result' >/dev/null 2>&1; then
            echo "$response" | jq -r '.result'
            return 0
        fi
        
        ((attempt++))
        if [[ $attempt -lt $MAX_CLAUDE_RETRIES ]]; then
            echo -e "${YELLOW}⚠️  Claude call failed, retrying in ${CLAUDE_RETRY_DELAY}s...${NC}"
            sleep $CLAUDE_RETRY_DELAY
        fi
    done
    
    echo -e "${RED}❌ Failed to get response from Claude after $MAX_CLAUDE_RETRIES attempts${NC}"
    return 1
}

# Create the analysis prompt
create_full_diff "$TEMP_DIR/full.diff"

ANALYSIS_PROMPT="Analyze these git changes and create a commit plan. Group related changes intelligently.

IMPORTANT RULES:
1. You can split changes within a single file across multiple commits if they serve different purposes
2. Group changes by feature/purpose, not just by file
3. Each commit should be logically complete and self-contained
4. Untracked files should be noted with their full path exactly as shown

File Status Summary:
$(for file in "${modified_files[@]}"; do echo "- MODIFIED: $file"; done)
$(for file in "${untracked_files[@]}"; do echo "- UNTRACKED: $file"; done)
$(for file in "${deleted_files[@]}"; do echo "- DELETED: $file"; done)
$(for file in "${added_files[@]}"; do echo "- ADDED: $file"; done)

Full diff:
$(cat "$TEMP_DIR/full.diff")

Create a JSON response with this EXACT structure:
{
  \"commits\": [
    {
      \"message\": \"snapshot: <description> $(date +'%b-%d-%y %I:%M%p' | tr '[:lower:]' '[:upper:]')\",
      \"files\": [
        {
          \"path\": \"exact/file/path\",
          \"action\": \"modify|add|delete\",
          \"partial\": true/false,
          \"changes\": \"Description of specific changes if partial\"
        }
      ]
    }
  ]
}

For partial file commits, describe which specific changes to include."

# Get Claude's analysis
echo -e "${CYAN}🤖 Analyzing changes with Claude...${NC}"
ANALYSIS=$(call_claude "$ANALYSIS_PROMPT") || exit 1

# Save analysis for debugging
echo "$ANALYSIS" > "$TEMP_DIR/analysis.json"

# Parse the analysis
if ! echo "$ANALYSIS" | jq -e '.commits' >/dev/null 2>&1; then
    echo -e "${RED}❌ Invalid response format from Claude${NC}"
    exit 1
fi

# Get number of commits
NUM_COMMITS=$(echo "$ANALYSIS" | jq -r '.commits | length')
echo -e "${GREEN}✅ Claude identified $NUM_COMMITS logical commits${NC}"

# Track which files have been fully committed
declare -A committed_files

# Process each commit
commit_count=0
while [[ $commit_count -lt $NUM_COMMITS ]]; do
    COMMIT_MSG=$(echo "$ANALYSIS" | jq -r ".commits[$commit_count].message")
    echo -e "\n${CYAN}📝 Creating commit $((commit_count + 1))/$NUM_COMMITS: $COMMIT_MSG${NC}"
    
    # Create working directory for this commit
    COMMIT_DIR="$TEMP_DIR/commit_$commit_count"
    mkdir -p "$COMMIT_DIR"
    
    # Get files for this commit
    FILES=$(echo "$ANALYSIS" | jq -r ".commits[$commit_count].files")
    
    # Process each file in this commit
    echo "$FILES" | jq -c '.[]' | while IFS= read -r file_entry; do
        FILE_PATH=$(echo "$file_entry" | jq -r '.path')
        ACTION=$(echo "$file_entry" | jq -r '.action')
        IS_PARTIAL=$(echo "$file_entry" | jq -r '.partial')
        
        echo "  - Processing $FILE_PATH (action: $ACTION, partial: $IS_PARTIAL)"
        
        case "$ACTION" in
            "add")
                # For untracked files, simply stage them
                git add "$FILE_PATH"
                ;;
            "delete")
                # For deleted files, stage the deletion
                git rm "$FILE_PATH" 2>/dev/null || git add "$FILE_PATH"
                ;;
            "modify")
                if [[ "$IS_PARTIAL" == "true" ]]; then
                    # For partial changes, we need to create a patch
                    # This is where interdiff would be most useful
                    # For now, stage the entire file
                    git add "$FILE_PATH"
                else
                    git add "$FILE_PATH"
                fi
                ;;
        esac
    done
    
    # Create the commit
    if [[ -n "$(git diff --cached)" ]]; then
        git commit -m "$COMMIT_MSG"
        echo -e "${GREEN}✅ Commit created successfully${NC}"
    else
        echo -e "${YELLOW}⚠️  No changes staged for this commit${NC}"
    fi
    
    ((commit_count++))
done

echo -e "\n${GREEN}🎉 Successfully created $commit_count commits using interdiff approach${NC}"

# Update todo status
if [[ $commit_count -gt 0 ]]; then
    echo -e "${CYAN}📊 Summary:${NC}"
    git log --oneline -n "$commit_count"
fi