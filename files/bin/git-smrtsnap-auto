#!/bin/bash

# Start total timer
TOTAL_START=$(date +%s)

# Check if claude is available
if ! command -v claude &> /dev/null; then
    echo "Error: 'claude' command not found. Please install Claude CLI." >&2
    exit 1
fi

# Check if in a git repository
if ! git rev-parse --git-dir &> /dev/null; then
    echo "Error: Not in a git repository" >&2
    exit 1
fi

# Check if git-snapshotc is available
if ! command -v git-snapshotc &> /dev/null; then
    echo "Error: 'git-snapshotc' command not found in PATH" >&2
    echo "Make sure files/bin is in your PATH" >&2
    exit 1
fi

# Function to check if there are any changes
has_changes() {
    [ -n "$(git status --porcelain)" ]
}

# Set up cleanup with portable mktemp
TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/git-smrtsnap-auto.XXXXXX") || {
    echo "Error: Failed to create temporary directory" >&2
    exit 1
}
chmod 700 "$TEMP_DIR"
trap 'rm -rf "$TEMP_DIR" 2>/dev/null' EXIT INT TERM

# Track full planning history for context
PLANNING_HISTORY="$TEMP_DIR/planning-history.txt"
> "$PLANNING_HISTORY"  # Initialize empty

# Main loop - continue until no changes remain
ITERATION=0
MAX_ITERATIONS=20
while has_changes; do
    ((ITERATION++))
    
    # Prevent infinite loops
    if [ $ITERATION -gt $MAX_ITERATIONS ]; then
        echo "Error: Exceeded maximum iterations ($MAX_ITERATIONS). Aborting to prevent infinite loop." >&2
        echo "Remaining changes can be committed manually." >&2
        exit 1
    fi
    
    # Double-check we still have changes
    if ! has_changes; then
        echo -e "\n✨ No changes remaining!"
        break
    fi
    
    # Ensure temp directory still exists (it might have been cleaned up on error)
    if [ ! -d "$TEMP_DIR" ]; then
        echo "Error: Temporary directory was cleaned up unexpectedly. Recreating..." >&2
        TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/git-smrtsnap-auto.XXXXXX") || {
            echo "Error: Failed to create temporary directory" >&2
            exit 1
        }
        chmod 700 "$TEMP_DIR"
        # Recreate planning history file
        PLANNING_HISTORY="$TEMP_DIR/planning-history.txt"
        > "$PLANNING_HISTORY"
    fi
    
    # Check if there are staged changes
    if [ -z "$(git diff --cached --name-only)" ]; then
        echo -e "\n🔄 Iteration $ITERATION: Analyzing remaining changes..."
        
        # Save current diff including untracked files
        DIFF_FILE="$TEMP_DIR/diff-$ITERATION.txt"
        {
            # First, show the regular diff for tracked files with more context
            git --no-pager diff --no-color -U10
            
            # Then, show untracked files as new file diffs
            git status --porcelain | grep "^??" | cut -c4- | while IFS= read -r file; do
                if [ -f "$file" ]; then
                    echo "diff --git a/$file b/$file"
                    # Check if file is executable
                    if [ -x "$file" ]; then
                        echo "new file mode 100755"
                    else
                        echo "new file mode 100644"
                    fi
                    echo "index 0000000..0000000"
                    echo "--- /dev/null"
                    echo "+++ b/$file"
                    lines=$(wc -l < "$file")
                    echo "@@ -0,0 +1,$lines @@"
                    sed 's/^/+/' "$file"
                elif [ -d "$file" ]; then
                    # For directories, show all files within
                    find "$file" -type f | while IFS= read -r subfile; do
                        echo "diff --git a/$subfile b/$subfile"
                        # Check if file is executable
                        if [ -x "$subfile" ]; then
                            echo "new file mode 100755"
                        else
                            echo "new file mode 100644"
                        fi
                        echo "index 0000000..0000000"
                        echo "--- /dev/null"
                        echo "+++ b/$subfile"
                        lines=$(wc -l < "$subfile")
                        echo "@@ -0,0 +1,$lines @@"
                        sed 's/^/+/' "$subfile"
                    done
                fi
            done
        } > "$DIFF_FILE"
        
        # Create the analysis prompt
        ANALYSIS_PROMPT='Analyze this git diff AND status to identify the NEXT logical commit.
Create a git patch containing changes for one complete feature.

Output format:
===COMMIT_START===
DESCRIPTION: Brief description (max 30 chars)
REASONING: One line explaining why these changes belong together
===PATCH_START===
[Insert a valid git diff patch containing ONLY the changes for this feature]
===PATCH_END===
===COMMIT_END===

Rules:
- Pick ONE COMPLETE FEATURE - include ALL files needed for it to work
- CRITICAL: If adding aliases/commands, include BOTH the config AND implementation files
- CRITICAL: The patch MUST include ALL files mentioned in DESCRIPTION/REASONING
- IMPORTANT: Look at git status - files marked with ?? are UNTRACKED and already exist
- For UNTRACKED files (??), the diff already shows them as new files with proper headers
- For MODIFIED files (M), use the diff as shown
- Examples of complete features:
  - Git aliases + their script implementations + prompt files
  - Config change + its supporting files
  - Documentation files that stand alone
- Group files that would be broken without each other
- VERIFY: Count the files in your patch and ensure it matches your plan

Here is the current status and diff:

IMPORTANT CONTEXT - Previous iteration plans and outcomes:'
        
        # Include planning history if this is not the first iteration
        if [ $ITERATION -gt 1 ] && [ -s "$PLANNING_HISTORY" ]; then
            ANALYSIS_PROMPT="${ANALYSIS_PROMPT}
$(cat "$PLANNING_HISTORY")

Based on the above plans from previous iterations, identify the NEXT logical commit that hasn't been completed yet."
        fi
        
        ANALYSIS_PROMPT="${ANALYSIS_PROMPT}

Current remaining changes:"

        echo "Sending changes to Claude for analysis..."
        
        # Try up to 3 times
        MAX_CLAUDE_ATTEMPTS=3
        CLAUDE_ATTEMPT=0
        CLAUDE_SUCCESS=false
        
        # Create response file
        RESPONSE_FILE="$TEMP_DIR/response-$ITERATION.txt"
        
        # Create a debug file to see what we're sending
        DEBUG_INPUT="$TEMP_DIR/debug-input-$ITERATION.txt"
        {
            echo "$ANALYSIS_PROMPT"
            echo ""
            echo "=== GIT STATUS ==="
            git status --porcelain
            echo ""
            echo "=== GIT DIFF ==="
            cat "$DIFF_FILE"
        } > "$DEBUG_INPUT"
        
        # Check input size
        INPUT_SIZE=$(wc -c < "$DEBUG_INPUT")
        if [ $INPUT_SIZE -gt 500000 ]; then
            echo "Warning: Input is very large ($(numfmt --to=iec $INPUT_SIZE 2>/dev/null || echo "$INPUT_SIZE bytes")). Claude may have trouble processing it." >&2
        fi
        
        while [ $CLAUDE_ATTEMPT -lt $MAX_CLAUDE_ATTEMPTS ] && [ "$CLAUDE_SUCCESS" = false ]; do
            ((CLAUDE_ATTEMPT++))
            
            if [ $CLAUDE_ATTEMPT -gt 1 ]; then
                echo "⚠️  Retry attempt $CLAUDE_ATTEMPT of $MAX_CLAUDE_ATTEMPTS..."
                # Brief pause before retry
                sleep 2
            fi
            
            # Start timer
            START_TIME=$(date +%s)
            
            # Send to Claude
            claude --print < "$DEBUG_INPUT" > "$RESPONSE_FILE" 2>&1 &
            
            CLAUDE_PID=$!
            
            # Show elapsed time while waiting with timeout
            echo -n "⏱️  Elapsed: "
            TIMEOUT=300  # 5 minutes
            while kill -0 $CLAUDE_PID 2>/dev/null; do
                CURRENT_TIME=$(date +%s)
                ELAPSED=$((CURRENT_TIME - START_TIME))
                printf "\r⏱️  Elapsed: %ds" $ELAPSED
                
                # Check for timeout
                if [ $ELAPSED -gt $TIMEOUT ]; then
                    echo -e "\n⚠️  Timeout: Claude is taking too long (>${TIMEOUT}s). Killing process..." >&2
                    kill $CLAUDE_PID 2>/dev/null
                    wait $CLAUDE_PID
                    echo "Error: Claude request timed out" > "$RESPONSE_FILE"
                    break
                fi
                
                sleep 1
            done
            
            # Wait for completion
            wait $CLAUDE_PID
            CLAUDE_EXIT=$?
            printf "\r⏱️  Completed in %ds\n" $(($(date +%s) - START_TIME))
            
            # Check if we got a valid response
            if [ $CLAUDE_EXIT -eq 0 ] && [ -s "$RESPONSE_FILE" ]; then
                # Check for "Execution error" in response
                if grep -q "Execution error" "$RESPONSE_FILE" 2>/dev/null; then
                    echo "⚠️  Claude returned 'Execution error'" >&2
                else
                    CLAUDE_SUCCESS=true
                fi
            else
                echo "⚠️  Claude request failed (exit code: $CLAUDE_EXIT)" >&2
            fi
        done
        
        if [ "$CLAUDE_SUCCESS" = false ]; then
            echo "Error: Failed to get commit plan from Claude after $MAX_CLAUDE_ATTEMPTS attempts" >&2
            cat "$RESPONSE_FILE" >&2
            # Continue to show the error and prompt, don't exit yet
        fi
        
        # Save the full response for planning history
        echo "=== ITERATION $ITERATION PLAN ===" >> "$PLANNING_HISTORY"
        echo "Timestamp: $(date)" >> "$PLANNING_HISTORY"
        grep -E "^(DESCRIPTION:|REASONING:|Files:|===)" "$RESPONSE_FILE" >> "$PLANNING_HISTORY" || true
        echo "" >> "$PLANNING_HISTORY"
        
        # Parse the response (even if Claude failed, we need to check)
        IN_COMMIT=false
        IN_PATCH=false
        DESCRIPTION=""
        REASONING=""
        PATCH_FILE="$TEMP_DIR/patch-$ITERATION.diff"
        
        > "$PATCH_FILE"  # Clear patch file
        
        # Only parse if Claude succeeded
        if [ "$CLAUDE_SUCCESS" = true ] && [ -s "$RESPONSE_FILE" ]; then
            while IFS= read -r line; do
            if [[ "$line" == "===COMMIT_START===" ]]; then
                IN_COMMIT=true
            elif [[ "$line" == "===COMMIT_END===" ]]; then
                IN_COMMIT=false
            elif [[ "$IN_COMMIT" == true ]]; then
                if [[ "$line" =~ ^DESCRIPTION:\ (.+)$ ]]; then
                    DESCRIPTION="${BASH_REMATCH[1]}"
                elif [[ "$line" =~ ^REASONING:\ (.+)$ ]]; then
                    REASONING="${BASH_REMATCH[1]}"
                elif [[ "$line" == "===PATCH_START===" ]]; then
                    IN_PATCH=true
                elif [[ "$line" == "===PATCH_END===" ]]; then
                    IN_PATCH=false
                elif [[ "$IN_PATCH" == true ]]; then
                    echo "$line" >> "$PATCH_FILE"
                fi
            fi
            done < "$RESPONSE_FILE"
        fi
        
        # Validate we have a patch
        if [ -z "$DESCRIPTION" ] || [ ! -s "$PATCH_FILE" ]; then
            echo "Error: Claude did not provide a valid commit plan" >&2
            echo "Description found: '$DESCRIPTION'" >&2
            echo "Patch file size: $(wc -c < "$PATCH_FILE") bytes" >&2
            echo "Response file size: $(wc -c < "$RESPONSE_FILE") bytes" >&2
            echo "" >&2
            
            # If response is empty or very short, show what we sent
            if [ ! -s "$RESPONSE_FILE" ] || [ $(wc -c < "$RESPONSE_FILE") -lt 50 ]; then
                echo "Claude returned empty or error response. Input was:" >&2
                echo "First 100 lines of input:" >&2
                head -n 100 "$DEBUG_INPUT" | sed 's/^/  /' >&2
                echo "" >&2
                echo "Input file size: $(wc -c < "$DEBUG_INPUT") bytes" >&2
                echo "Number of lines: $(wc -l < "$DEBUG_INPUT")" >&2
                
                # If it's exactly "Execution error", try a simpler approach
                if grep -q "Execution error" "$RESPONSE_FILE" 2>/dev/null; then
                    echo "" >&2
                    echo "Claude returned 'Execution error'. This might be due to input complexity." >&2
                    echo "Try running with fewer changes or check Claude's status." >&2
                fi
            else
                echo "Claude's response:" >&2
                cat "$RESPONSE_FILE" >&2
            fi
            
            # Save debug files for manual inspection
            echo "" >&2
            echo "Debug files saved in: $TEMP_DIR" >&2
            echo "  Input: debug-input-$ITERATION.txt" >&2
            echo "  Response: response-$ITERATION.txt" >&2
            
            # Offer fallback option
            echo "" >&2
            echo "Would you like to:" >&2
            echo "  1) Retry with a smaller batch" >&2
            echo "  2) Stage all remaining changes manually" >&2
            echo "  3) Exit" >&2
            printf "Choice [1-3]: " >&2
            read -n 1 choice
            echo "" >&2
            
            case "$choice" in
                1)
                    echo "Retrying with first 10 files only..." >&2
                    # Don't clean up temp dir on retry
                    trap - EXIT
                    # Limit to first 10 untracked files
                    git status --porcelain | head -10 | cut -c4- | while read -r file; do
                        git add "$file" 2>/dev/null || true
                    done
                    continue
                    ;;
                2)
                    echo "Staging all remaining changes..." >&2
                    git add -A
                    git-snapshotc
                    exit 0
                    ;;
                *)
                    # Don't clean up on exit so user can inspect
                    trap - EXIT
                    exit 1
                    ;;
            esac
        fi
        
        # Show the plan
        echo -e "\n📋 Next commit:"
        echo "Description: $DESCRIPTION"
        echo "Reasoning: $REASONING"
        
        # Show what files will be affected
        echo -e "\nFiles to be modified:"
        # Extract ALL file paths from the patch - both from diff headers and the patch itself
        FILE_LIST=""
        FILE_COUNT=0
        
        # Method 1: Extract from diff headers
        while IFS= read -r line; do
            if [[ "$line" =~ [[:space:]]b/(.+)$ ]]; then
                FILE_LIST="${FILE_LIST}${BASH_REMATCH[1]}"$'\n'
            fi
        done < <(grep -E "^diff --git" "$PATCH_FILE")
        
        # Method 2: Also check for any +++ b/ lines (new files)
        while IFS= read -r line; do
            if [[ "$line" =~ ^\+\+\+[[:space:]]b/(.+)$ ]]; then
                FILE_LIST="${FILE_LIST}${BASH_REMATCH[1]}"$'\n'
            fi
        done < <(grep -E "^\+\+\+ b/" "$PATCH_FILE")
        
        # Sort and deduplicate the combined list
        UNIQUE_FILES=$(echo "$FILE_LIST" | sort -u | grep -v '^$')
        
        # Display the files
        while IFS= read -r file; do
            [ -n "$file" ] && echo "  $file" && ((FILE_COUNT++))
        done <<< "$UNIQUE_FILES"
        
        # If no files found, something is wrong
        if [ $FILE_COUNT -eq 0 ]; then
            echo "  (No files detected - patch may be empty)"
        fi
        
        printf "\nProceed with this commit? [Y/n/v]: "
        read answer
        
        if [ "$answer" = "v" ] || [ "$answer" = "V" ]; then
            # View the patch
            echo -e "\n📄 Patch content:"
            cat "$PATCH_FILE"
            echo -e "\n📊 Patch statistics:"
            echo "  Lines: $(wc -l < "$PATCH_FILE")"
            echo "  Size: $(wc -c < "$PATCH_FILE") bytes"
            printf "\nProceed with this commit? [Y/n]: "
            read answer
        fi
        
        if [ -z "$answer" ] || [ "$answer" = "Y" ] || [ "$answer" = "y" ]; then
            echo -e "\n🔧 Applying patch..."
            
            # First, save the current state of ALL changes
            FULL_DIFF="$TEMP_DIR/full-diff-$ITERATION.patch"
            git add -A
            git diff --cached --no-color -U10 > "$FULL_DIFF"
            
            # Log the size of the full diff
            echo "  Full diff size: $(wc -l < "$FULL_DIFF") lines, $(wc -c < "$FULL_DIFF") bytes"
            
            git reset HEAD -- . >/dev/null 2>&1
            
            # Check if this is dealing with untracked files
            UNTRACKED_IN_PATCH=false
            PATCH_FILES=""
            while IFS= read -r line; do
                if [[ "$line" =~ ^diff\ --git\ a/(.+)\ b/(.+)$ ]]; then
                    FILE_PATH="${BASH_REMATCH[2]}"
                    PATCH_FILES="${PATCH_FILES}${FILE_PATH}"$'\n'
                    # Check if this file is untracked
                    if git status --porcelain | grep -q "^?? ${FILE_PATH}$"; then
                        UNTRACKED_IN_PATCH=true
                    fi
                fi
            done < "$PATCH_FILE"
            
            # Different handling for untracked vs modified files
            if [ "$UNTRACKED_IN_PATCH" = true ]; then
                echo "  Detected untracked files in patch, using direct staging..."
                
                # For untracked files, just add them directly
                echo "$PATCH_FILES" | sort -u | grep -v '^$' | while IFS= read -r file; do
                    if [ -n "$file" ] && [ -e "$file" ]; then
                        echo "  Adding: $file"
                        git add "$file"
                        
                        # Check for executable permissions in the patch
                        if grep -A1 "^diff --git.*b/${file}$" "$PATCH_FILE" | grep -q "^new file mode 100755"; then
                            chmod +x "$file"
                            echo "  Made executable: $file"
                        fi
                    fi
                done
            else
                # For modified files, use git apply
                if git apply --check "$PATCH_FILE" 2>/dev/null; then
                    # Apply with whitespace fix, capture warnings
                    APPLY_OUTPUT=$(git apply --whitespace=fix "$PATCH_FILE" 2>&1)
                    WARNING_COUNT=$(echo "$APPLY_OUTPUT" | grep -c "warning:" || true)
                    if [ $WARNING_COUNT -gt 0 ]; then
                        echo "  (Fixed $WARNING_COUNT whitespace issues)"
                    fi
                    
                    # Stage all changes from the patch
                    git add -A
                else
                    echo "⚠️  Error: Failed to apply patch" >&2
                    git apply --check "$PATCH_FILE" 2>&1 | sed 's/^/  /'
                    PATCH_FAILED=true
                fi
            fi
            
            if [ "${PATCH_FAILED:-false}" != true ]; then
                
                # Show what's staged
                echo -e "\nStaged changes:"
                git --no-pager diff --cached --name-status
                
                # Create the commit
                echo -e "\nCreating snapshot commit..."
                git-snapshotc
                
                # Record success in planning history
                echo "OUTCOME: Committed - $DESCRIPTION" >> "$PLANNING_HISTORY"
                echo "" >> "$PLANNING_HISTORY"
                
                # Create a reverse patch of what we just committed
                REVERSE_PATCH="$TEMP_DIR/reverse-$ITERATION.patch"
                git diff HEAD~1 HEAD --no-color > "$REVERSE_PATCH"
                
                # Apply reverse patch to remove committed changes from full diff
                # This creates a new diff with only remaining changes
                REMAINING_DIFF="$TEMP_DIR/remaining-$ITERATION.patch"
                cp "$FULL_DIFF" "$REMAINING_DIFF"
                
                # Try to apply the reverse patch to the remaining diff
                # This removes the committed changes from our saved state
                if [ -s "$REVERSE_PATCH" ]; then
                    echo "  Reverse patch size: $(wc -l < "$REVERSE_PATCH") lines"
                    
                    # Create a temporary directory for patch operations
                    PATCH_WORK_DIR="$TEMP_DIR/patch-work-$ITERATION"
                    mkdir -p "$PATCH_WORK_DIR"
                    
                    # Apply the full diff to the work directory
                    echo "  Applying full diff to temp directory..."
                    if (cd "$PATCH_WORK_DIR" && git init -q && git apply --whitespace=fix "$FULL_DIFF" 2>"$TEMP_DIR/apply-full-error.log"); then
                        echo "  ✓ Full diff applied successfully"
                    else
                        echo "  ⚠️  Warning: Failed to apply full diff cleanly"
                        cat "$TEMP_DIR/apply-full-error.log" | sed 's/^/    /'
                    fi
                    
                    # Apply the reverse patch
                    echo "  Applying reverse patch..."
                    if (cd "$PATCH_WORK_DIR" && git apply -R --whitespace=fix "$REVERSE_PATCH" 2>"$TEMP_DIR/apply-reverse-error.log"); then
                        echo "  ✓ Reverse patch applied successfully"
                    else
                        echo "  ⚠️  Warning: Failed to apply reverse patch cleanly"
                        cat "$TEMP_DIR/apply-reverse-error.log" | sed 's/^/    /'
                    fi
                    
                    # Generate the remaining diff
                    (cd "$PATCH_WORK_DIR" && git add -A && git diff --cached --no-color > "$REMAINING_DIFF")
                    echo "  Remaining diff size: $(wc -l < "$REMAINING_DIFF") lines"
                    
                    # Clean up work directory
                    rm -rf "$PATCH_WORK_DIR"
                fi
                
                # Restore remaining changes
                if [ -s "$REMAINING_DIFF" ]; then
                    echo -e "\n🔄 Restoring remaining changes..."
                    if git apply --whitespace=fix "$REMAINING_DIFF" 2>"$TEMP_DIR/restore-error.log"; then
                        echo "  ✓ Successfully restored $(wc -l < "$REMAINING_DIFF") lines of changes"
                    else
                        # Fallback: try with --3way for better conflict resolution
                        echo "  Trying 3-way merge..."
                        if git apply --3way --whitespace=fix "$REMAINING_DIFF" 2>"$TEMP_DIR/restore-3way-error.log"; then
                            echo "  ✓ Successfully restored changes using 3-way merge"
                        else
                            echo "  ⚠️  Warning: Some changes couldn't be restored cleanly"
                            echo "  Error details:"
                            cat "$TEMP_DIR/restore-3way-error.log" | sed 's/^/    /'
                            echo ""
                            echo "  Debug files saved in: $TEMP_DIR"
                            echo "    - full-diff-$ITERATION.patch (original state)"
                            echo "    - reverse-$ITERATION.patch (what was committed)"
                            echo "    - remaining-$ITERATION.patch (what should be restored)"
                        fi
                    fi
                else
                    echo "  No remaining changes to restore"
                fi
            else
                echo "⚠️  Error: Failed to apply patch" >&2
                echo "Patch validation errors:"
                echo "  Patch failed or files could not be processed"
                
                # Show current git status for context
                echo -e "\nCurrent git status:"
                git status --porcelain | head -20 | sed 's/^/  /'
                
                # Check if files in patch already exist
                echo -e "\nChecking patch files:"
                grep -E "^diff --git" "$PATCH_FILE" | while IFS= read -r line; do
                    if [[ "$line" =~ [[:space:]]b/(.+)$ ]]; then
                        file="${BASH_REMATCH[1]}"
                        if [ -e "$file" ]; then
                            echo "  $file - exists ($(file -b "$file" 2>/dev/null || echo "unknown type"))"
                        else
                            echo "  $file - does not exist"
                        fi
                    fi
                done
                
                # Show the patch content for debugging
                echo -e "\nPatch content (first 50 lines):"
                head -n 50 "$PATCH_FILE" | sed 's/^/  /'
                
                # Record failure in planning history
                echo "OUTCOME: Failed to apply patch - $DESCRIPTION" >> "$PLANNING_HISTORY"
                echo "" >> "$PLANNING_HISTORY"
                
                echo -e "\nDebug files saved in: $TEMP_DIR"
                echo "  - patch-$ITERATION.diff (the patch that failed)"
                echo "  - full-diff-$ITERATION.patch (current state)"
                
                echo -e "\nTrying next iteration with remaining changes..."
            fi
        else
            echo "Aborted by user."
            # Record skip in planning history
            echo "OUTCOME: Skipped by user - $DESCRIPTION" >> "$PLANNING_HISTORY"
            echo "" >> "$PLANNING_HISTORY"
            exit 0
        fi
    else
        # Files are already staged - use normal snapshotc process
        echo -e "\n📦 Found staged changes, creating commit..."
        git-snapshotc
    fi
    
    # Check if there are still changes after the commit
    if ! has_changes; then
        echo -e "\n✨ No more changes to commit!"
        break
    fi
done

echo -e "\n✅ All changes committed!"

# Show total elapsed time
TOTAL_END=$(date +%s)
TOTAL_ELAPSED=$((TOTAL_END - TOTAL_START))
TOTAL_MINS=$((TOTAL_ELAPSED / 60))
TOTAL_SECS=$((TOTAL_ELAPSED % 60))

if [ $TOTAL_MINS -gt 0 ]; then
    echo -e "\n⏱️  Total time: ${TOTAL_MINS}m ${TOTAL_SECS}s"
else
    echo -e "\n⏱️  Total time: ${TOTAL_ELAPSED}s"
fi
