[core]
	autocrlf = input
	editor = cursor --wait
	excludesfile = ~/.gitignore
[alias]
	branch-name = rev-parse --abbrev-ref HEAD
	pub = !git push -u origin $(git branch-name)
	password = !reset-github-password
	redo = commit --amend --no-edit
	lc = rev-parse --short HEAD
	ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	co = checkout
	gp = git push
	gc = git commit -m
	ga = git add
	gst = git status
[push]
	default = simple
[user]
	email = thomas@mfrwdesign.com
	name = Thomas Sample
[color]
	ui = true
[credential]
	helper = osxkeychain
[filter "lfs"]
	clean = git lfs clean %f
	smudge = git lfs smudge %f
	required = true
[github]
	user = MFRWDesign
[commit]
	gpgsign = false
[init]
	defaultBranch = main
[merge]
	ff = no
[pull]
	ff = only
	rebase = false
[rebase]
	autosquash = true
[rerere]
	enabled = true