mcd () {
  mkdir "$1"
  cd "$1"
}

# Load zsh customizations
for f in ~/.zsh/*; do source $f; done

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Add ~/bin and Homebrew to PATH (covers both Intel and Apple Silicon)
export PATH="$HOME/bin:/usr/local/bin:/usr/local/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# Workbrew (work machine only)
if [ -d /opt/workbrew ]; then
  export PATH="/opt/workbrew/bin:$PATH"
fi

# Add pipx bin directory to PATH (for fabric and other pipx-installed tools)
export PATH="$PATH:$HOME/.local/bin"

# Fabric AI tool configuration
if [ -f "$HOME/.config/fabric/fabric-bootstrap.inc" ]; then
  source "$HOME/.config/fabric/fabric-bootstrap.inc"
fi

# Load local environment variables and secrets (if exists)
if [ -f "$HOME/.zshrc.local" ]; then
  source "$HOME/.zshrc.local"
fi

# Atuin shell history (if installed)
if command -v atuin &>/dev/null; then
  eval "$(atuin init zsh)"
fi